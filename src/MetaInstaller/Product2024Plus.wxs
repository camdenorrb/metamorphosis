				<File Id="MetamorphosisCore.dll2025" Name="MetamorphosisCore.dll" Source="$(var.ProjectDir)\..\MetamorphosisCore\bin\Release2025\net8.0-windows\MetamorphosisCore.dll" Checksum="no"/>
				<File Id="MetamorphosisCore.deps.json2025" Name="MetamorphosisCore.deps.json" Source="$(var.ProjectDir)\..\MetamorphosisCore\bin\Release2025\net8.0-windows\MetamorphosisCore.deps.json" Checksum="no"/>
				<File Id="MetamorphosisCore.dll.config2025" Name="MetamorphosisCore.dll.config" Source="$(var.ProjectDir)\..\MetamorphosisCore\bin\Release2025\net8.0-windows\MetamorphosisCore.dll.config" Checksum="no"/>
				<File Id="MetamorphosisCore.runtimeconfig.json2025" Name="MetamorphosisCore.runtimeconfig.json" Source="$(var.ProjectDir)\..\MetamorphosisCore\bin\Release2025\net8.0-windows\MetamorphosisCore.runtimeconfig.json" Checksum="no"/>
			</Component>
			<Component Id="NewtonSoft2025" Guid="{EC47822D-43CE-4E3A-85B2-E39616822025}" DiskId="1">
				<File Id="NewtonSoft2025" Name="Newtonsoft.Json.dll" Source="$(var.ProjectDir)\..\MetamorphosisCore\bin\Release2025\net8.0-windows\Newtonsoft.Json.dll" Checksum="no"/>
			</Component>
			<Component Id="SQLite2025" Guid="{EFF1EEA0-8CC2-48A7-8865-D36BCD592025}" DiskId="1">
				<File Id="SQLite2025" Name="System.Data.SQLite.dll" Source="$(var.ProjectDir)\..\MetamorphosisCore\bin\Release2025\net8.0-windows\System.Data.SQLite.dll" Checksum="no"/>
			</Component>
			<Component Id="Settings2025.xml" Guid="{EAD42FD5-720D-4EAE-871E-C7D10D502025}" DiskId="1">
				<File Id="Settings2025" Name="Settings.xml" Source="$(var.ProjectDir)\..\MetamorphosisCore\bin\Release2025\net8.0-windows\Settings.xml" Checksum="no"/>
			</Component>
			<Component Id="SQLiteInterop2025" Guid="{ED743C72-6984-4009-B440-2763207A2025}" DiskId="1">
				<File Id="SQLiteInterop2025" Name="SQLite.Interop.dll" Source="$(var.ProjectDir)\..\MetamorphosisCore\bin\Release2025\net8.0-windows\runtimes\win-x64\native\SQLite.Interop.dll" Checksum="no"/>
			</Component>
